generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model Auction {
  id            Int      @id @default(autoincrement())
  title         String
  description   String
  category      String
  startingPrice Float
  currentBid    Float
  bids          Int      @default(0)
  image         String
  endsAt        DateTime
  seller        String
  createdAt     DateTime @default(now())
}